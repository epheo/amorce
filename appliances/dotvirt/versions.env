# The dotvirt appliance's pins; build.sh passes them, and any of them set in
# the environment wins. Upstream manifests are pinned in manifests.sha256.

# epheo/microshift, by digest: its CI may republish a tag.
# epheo.49 or later: apiServer.authenticationConfig, and the data disks
# from the installer's plan at /etc/amorce/data-disks.json.
BASE_IMAGE=ghcr.io/epheo/microshift:5.0.0_202610291612.p0_g0f0de241_5.0.0_okd_scos.8_epheo.51@sha256:857eb17e06881f4a529e837379989750c5ff5e37c2aef8445dfe374e8d2e0a10

# The portail image the base embeds (its portail.image label), as the
# base's import names it: nodes never pull.
PORTAIL_IMAGE=localhost/embedded/portail:0.3.0

# dotvirt's operator.yaml release asset: CRD, RBAC and the operator, every
# image by digest. Empty DOTVIRT_RELEASE: build.sh needs DOTVIRT_OPERATOR_YAML,
# a file rendered from a dotvirt tree (README, Building).
DOTVIRT_RELEASE=
DOTVIRT_OPERATOR_YAML_SHA256=

KANIDM_SERVER_IMAGE=docker.io/kanidm/server:1.12.2@sha256:555618fc71aa5cbbacf0041136f8a5430615ee215d677386594726abcc18dbf0
# The kanidm CLI, which the server image lacks; run by podman at setup.
KANIDM_TOOLS_IMAGE=docker.io/kanidm/tools:1.12.2@sha256:75e07135412999b9517e61dd1c72328369cc1936299b91018b09d4f4066664f3
