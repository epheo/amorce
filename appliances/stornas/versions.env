# stornas-os's pins; build.sh passes them, and any of them set in the
# environment wins, for local builds only.

# epheo/microshift, by digest: its CI may republish a tag.
BASE_IMAGE=ghcr.io/epheo/microshift:5.0.0_202610291612.p0_g0f0de241_5.0.0_okd_scos.8_epheo.49@sha256:3853a0495932a6119a854f71cf127fad3229498df79fd4e26ebf60e11268f296

# The stornas commit whose manifests (image/manifests/stornas) go in, and
# its component images, which stornas's CI publishes for each main commit,
# by digest.
STORNAS_REV=
STORNAS_IMAGE=
STORNAS_OPERATOR_IMAGE=
STORNAS_AGENT_IMAGE=
